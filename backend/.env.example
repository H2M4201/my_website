# Prisma / SQL Server — URL form (not ADO.NET). Prisma CLI and the app read this file when copied to `.env`.
#
# Your SSMS-style settings map roughly to:
#   Data Source=localhost\SQLEXPRESS  →  host below (backslash URL-encoded as %5C)
#   Integrated Security=True          →  integratedSecurity=true
#   Encrypt=True; TrustServerCertificate=True  →  encrypt & trustServerCertificate
#
# Set `database` to the database that contains dbo.Section and dbo.Contact (e.g. h2m-website).
#
# Optional: use your machine name instead of localhost, e.g. ADNLT2002%5CSQLEXPRESS

DATABASE_URL="sqlserver://localhost%5CSQLEXPRESS;database=h2m-website;integratedSecurity=true;encrypt=true;trustServerCertificate=true"

# HTTP server
PORT=4000

# Comma-separated origins for CORS (optional; sensible localhost defaults are built in)
# CORS_ORIGIN=http://localhost:3000,https://localhost:3000
