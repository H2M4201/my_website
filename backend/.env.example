# ============================================
# Database Configuration — PostgreSQL
# ============================================
# Local native PostgreSQL:
#   DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database>"
#
# Docker -> native PostgreSQL on host:
#   DATABASE_URL="postgresql://<user>:<password>@host.docker.internal:5432/<database>"
#
# Supabase (production):
#   DATABASE_URL="postgresql://postgres:<password>@<ref>.supabase.co:5432/postgres"

DATABASE_URL="postgresql://postgres.vxhxrqaeubveolarctkn:Wq2kINO3Ok6rXLHQ@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ============================================
# Authentication
# ============================================
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here-replace-with-random-64-bytes-hex
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATION_SECRET=your-revalidation-secret-here-replace-with-random-32-bytes-hex

# ============================================
# Server Configuration
# ============================================
PORT=4000

# Comma-separated origins for CORS (optional; sensible localhost defaults are built in)
# CORS_ORIGIN=http://localhost:3000,https://localhost:3000

# Comma-separated frontend URLs for cache revalidation webhooks
FRONTEND_URLS=https://localhost:3000,https://localhost:5000
