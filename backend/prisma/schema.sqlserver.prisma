// ============================================
// Prisma Schema - SQL Server (Local Development)
// ============================================
// This file is used for local development with SQL Server.
// To use it, run: npm run prisma:generate:local
// ============================================

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Section {
  id          Int      @id @default(autoincrement())
  SectionName String   @db.NVarChar(100)
  Description String?  @db.NVarChar(500)
  Href        String?  @db.NVarChar(255)
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Section")
}

model Contact {
  id          Int      @id @default(autoincrement())
  ContactType String   @db.NVarChar(50)
  ContactInfo String   @db.NVarChar(255)
  Icon        String?  @db.NVarChar(100)
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Contact")
}

model Blog {
  id          Int      @id @default(autoincrement())
  Title       String   @db.NVarChar(255)
  Description String?  @db.NVarChar(1000)
  Content     String?  @db.NVarChar(max)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Blog")
}

model BlogCategory {
  id           Int      @id @default(autoincrement())
  CategoryName String   @db.NVarChar(255)
  SortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("BlogCategory")
}

model Trip {
  id          Int      @id @default(autoincrement())
  Title       String   @db.NVarChar(255)
  Description String?  @db.NVarChar(1000)
  Time        String?  @db.NVarChar(100)
  Location    String?  @db.NVarChar(255)
  Content     String?  @db.NVarChar(max)
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Trip")
}

model Recipe {
  id          Int      @id @default(autoincrement())
  Name        String   @db.NVarChar(255)
  Description String?  @db.NVarChar(1000)
  Ingredients String?  @db.NVarChar(max)
  Steps       String?  @db.NVarChar(max)
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredientRecipes IngredientRecipe[]

  @@map("Recipe")
}

model Ingredient {
  id             Int      @id @default(autoincrement())
  IngredientName String   @db.NVarChar(255)
  IsActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recipeLinks IngredientRecipe[]

  @@map("Ingredient")
}

model IngredientRecipe {
  ingredientID Int
  recipeID     Int
  sortOrder    Int      @default(0)

  ingredient Ingredient @relation(fields: [ingredientID], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeID], references: [id], onDelete: Cascade)

  @@id([ingredientID, recipeID])
  @@map("IngredientRecipe")
}

model Experience {
  id          Int      @id @default(autoincrement())
  Title       String   @db.NVarChar(255)
  Company     String   @db.NVarChar(255)
  Period      String   @db.NVarChar(100)
  Achievement String?  @db.NVarChar(1000)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobDescriptions JobDescription[]
  skills          ExperienceSkill[]

  @@map("Experience")
}

model JobDescription {
  id           Int      @id @default(autoincrement())
  Description  String   @db.NVarChar(1000)
  SortOrder    Int      @default(0)
  experienceId Int
  IsActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@map("JobDescription")
}

model ExperienceSkill {
  id           Int    @id @default(autoincrement())
  Skill        String @db.NVarChar(100)
  SortOrder    Int    @default(0)
  experienceId Int

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@map("ExperienceSkill")
}

model ExpertiseCategory {
  id          Int      @id @default(autoincrement())
  Category    String   @db.NVarChar(100)
  SortOrder   Int      @default(0)
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills      ExpertiseSkill[]

  @@map("ExpertiseCategory")
}

model ExpertiseSkill {
  id                 Int      @id @default(autoincrement())
  Skill              String   @db.NVarChar(100)
  SortOrder          Int      @default(0)
  expertiseCategoryId Int
  IsActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category ExpertiseCategory @relation(fields: [expertiseCategoryId], references: [id], onDelete: Cascade)

  @@map("ExpertiseSkill")
}

model AdminUser {
  id                    Int       @id @default(autoincrement())
  username              String    @unique @db.NVarChar(100)
  password              String    @db.NVarChar(255)
  email                 String?   @db.NVarChar(255)
  name                  String?   @db.NVarChar(255)
  roleId                Int?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  passwordChangedAt     DateTime?
  passwordResetToken    String?   @db.NVarChar(255)
  passwordResetTokenExpires DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("AdminUser")
}