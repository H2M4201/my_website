datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Section {
  id          Int     @id @default(autoincrement())
  SectionName String  @db.NVarChar(100)
  Description String? @db.NVarChar(500)
  Href        String? @db.NVarChar(255)

  @@map("Section")
}

model Contact {
  id          Int     @id @default(autoincrement())
  ContactType String  @db.NVarChar(50)
  ContactInfo String  @db.NVarChar(255)
  Icon        String? @db.NVarChar(100)

  @@map("Contact")
}

model Blog {
  id          Int     @id @default(autoincrement())
  Title       String  @db.NVarChar(255)
  Description String? @db.NVarChar(1000)
  Content     String? @db.NVarChar(max)

  @@map("Blog")
}

model Trip {
  id        Int     @id @default(autoincrement())
  Title     String  @db.NVarChar(255)
  Time      String? @db.NVarChar(100)
  Location  String? @db.NVarChar(255)
  Content   String? @db.NVarChar(max)

  @@map("Trip")
}

model Recipe {
  id          Int     @id @default(autoincrement())
  Name        String  @db.NVarChar(255)
  Description String? @db.NVarChar(1000)

  @@map("Recipe")
}

model Experience {
  id          Int      @id @default(autoincrement())
  Title       String   @db.NVarChar(255)
  Company     String   @db.NVarChar(255)
  Period      String   @db.NVarChar(100)
  Achievement String?  @db.NVarChar(1000)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobDescriptions JobDescription[]
  skills          ExperienceSkill[]

  @@map("Experience")
}

model JobDescription {
  id          Int      @id @default(autoincrement())
  Description String   @db.NVarChar(1000)
  SortOrder   Int      @default(0)
  experienceId Int

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@map("JobDescription")
}

model ExperienceSkill {
  id           Int      @id @default(autoincrement())
  Skill        String   @db.NVarChar(100)
  SortOrder    Int      @default(0)
  experienceId Int

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@map("ExperienceSkill")
}

model ExpertiseCategory {
  id          Int      @id @default(autoincrement())
  Category    String   @db.NVarChar(100)
  SortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills      ExpertiseSkill[]

  @@map("ExpertiseCategory")
}

model ExpertiseSkill {
  id                 Int      @id @default(autoincrement())
  Skill              String   @db.NVarChar(100)
  SortOrder          Int      @default(0)
  expertiseCategoryId Int

  category ExpertiseCategory @relation(fields: [expertiseCategoryId], references: [id], onDelete: Cascade)

  @@map("ExpertiseSkill")
}

model AdminUser {
  id                    Int       @id @default(autoincrement())
  username              String    @unique @db.NVarChar(100)
  password              String    @db.NVarChar(255)
  email                 String?   @db.NVarChar(255)
  name                  String?   @db.NVarChar(255)
  roleId                Int?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  passwordChangedAt     DateTime?
  passwordResetToken    String?   @db.NVarChar(255)
  passwordResetTokenExpires DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("AdminUser")
}
