// ============================================
// Prisma Schema - PostgreSQL
// ============================================
// Single source of truth for all environments (dev & prod).
// Migrations are committed to Git and deployed via CI/CD.
// ============================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Section {
  id          Int      @id @default(autoincrement())
  SectionName String
  Description String?
  Href        String?
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Section")
}

model Contact {
  id          Int      @id @default(autoincrement())
  ContactType String
  ContactInfo String
  Icon        String?
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Contact")
}

model Blog {
  id          Int      @id @default(autoincrement())
  Title       String
  Description String?
  Content     String?
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Blog")
}

model BlogCategory {
  id           Int      @id @default(autoincrement())
  CategoryName String
  SortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("BlogCategory")
}

model Trip {
  id          Int      @id @default(autoincrement())
  Title       String
  Description String?
  Time        String?
  Location    String?
  Content     String?
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Trip")
}

model Recipe {
  id          Int      @id @default(autoincrement())
  Name        String
  Description String?
  Ingredients String?
  Steps       String?
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredientRecipes IngredientRecipe[]

  @@map("Recipe")
}

model Ingredient {
  id             Int      @id @default(autoincrement())
  IngredientName String
  IsActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recipeLinks IngredientRecipe[]

  @@map("Ingredient")
}

model IngredientRecipe {
  ingredientID Int
  recipeID     Int
  sortOrder    Int      @default(0)

  ingredient Ingredient @relation(fields: [ingredientID], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeID], references: [id], onDelete: Cascade)

  @@id([ingredientID, recipeID])
  @@map("IngredientRecipe")
}

model Experience {
  id          Int      @id @default(autoincrement())
  Title       String
  Company     String
  Period      String
  Achievement String?
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobDescriptions JobDescription[]
  skills          ExperienceSkill[]

  @@map("Experience")
}

model JobDescription {
  id           Int      @id @default(autoincrement())
  Description  String
  SortOrder    Int      @default(0)
  experienceId Int
  IsActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@map("JobDescription")
}

model ExperienceSkill {
  id           Int    @id @default(autoincrement())
  Skill        String
  SortOrder    Int    @default(0)
  experienceId Int

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@map("ExperienceSkill")
}

model ExpertiseCategory {
  id          Int      @id @default(autoincrement())
  Category    String
  SortOrder   Int      @default(0)
  IsActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills      ExpertiseSkill[]

  @@map("ExpertiseCategory")
}

model ExpertiseSkill {
  id                 Int      @id @default(autoincrement())
  Skill              String
  SortOrder          Int      @default(0)
  expertiseCategoryId Int
  IsActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category ExpertiseCategory @relation(fields: [expertiseCategoryId], references: [id], onDelete: Cascade)

  @@map("ExpertiseSkill")
}

model AdminUser {
  id                    Int       @id @default(autoincrement())
  username              String    @unique
  password              String
  email                 String?
  name                  String?
  roleId                Int?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  passwordChangedAt     DateTime?
  passwordResetToken    String?
  passwordResetTokenExpires DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("AdminUser")
}