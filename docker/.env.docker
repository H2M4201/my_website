# ============================================
# Docker Environment Variables
# ============================================
# Copy this file and fill in your Supabase credentials.
# For local development, the .env files in each module are used instead.
# ============================================

# --- Supabase PostgreSQL Connection (for Docker/Production) ---
# Replace with your actual Supabase connection string
# Format: postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres"

# --- Revalidation Secret ---
# Must match across all services
REVALIDATION_SECRET=change-this-to-a-secure-random-string