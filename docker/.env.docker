# ============================================
# Docker Environment Variables
# ============================================
# This file is loaded by docker-compose.yml via env_file.
#
# DATABASE_URL — used by Prisma inside the backend container.
#
#   → "host.docker.internal" reaches the host machine's native PostgreSQL.
#   → "postgresql://..." connects to your Supabase project (production).
#
# For local development leave DATABASE_URL pointing to your host
# PostgreSQL.  In CI/CD the deploy.yml workflow overrides it with a
# GitHub secret so it never appears on disk here.
# ============================================

DATABASE_URL="postgresql://postgres.btsiqvnluiruqmeejnjh:Wq2kINO3Ok6rXLHQ@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.btsiqvnluiruqmeejnjh:Wq2kINO3Ok6rXLHQ@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# --- Revalidation Secret ---
# Must match across all services
REVALIDATION_SECRET=8e4d2f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6a8

# --- JWT Secret ---
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=a7f3c9e1b2d4f6a8c0e2d4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6a8