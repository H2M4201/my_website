# <type>(<scope>): <subject>
#
# Types: feat, fix, docs, style, refactor, test, chore, perf, ci, revert
# Scopes: homepage, adminPage, root (or other specific areas)
# Subject: imperative mood, no period, max 50 chars
#
# [optional body] - explain why, not what. If making a change that affects both
# homepage and adminPage, explain the relationship here.
#
# [optional footer] - Breaking changes, closes #issue

# Examples:
# feat(homepage): add new resume section
# fix(adminPage): resolve auth token expiration
# refactor(root): migrate shared styles to workspace root
